# ==============================================================================
# CampusFix Environment Configuration Template
# Copy this file to .env and set your secure local credentials:
# cp .env.example .env
# ==============================================================================

# PostgreSQL Credentials & Database Name
POSTGRES_USER=campusfix_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=campusfix_db
POSTGRES_PORT=5432

# Application Database Connection String
# Used by Next.js API / Backend ORM (e.g., Prisma, pg-promise, pg)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

